# Binance API (optional — only needed for private endpoints)
# Public endpoints (price, volume, OI, funding) work without keys
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Run interval in minutes (default: 60)
RUN_INTERVAL_MINUTES=60

# Max coins to output (default: 10, max: 10)
MAX_OUTPUT_COINS=10

# Enable debug logging
DEBUG=false
